#!/usr/bin/python3
# Runs on the host, between host-spawn's pty (allocated in the sandbox's devpts,
# so the host can't resolve its name) and a pty opened here on the host, so that
# tty, ttyname(), GPG_TTY, sudo and ps work in Terminal panel shells.
# usage: python3 host-pty COMMAND [ARGS...]
import errno
import fcntl
import os
import pty
import select
import signal
import sys
import termios
import tty

def copy_winsize(src, dst):
    try:
        fcntl.ioctl(dst, termios.TIOCSWINSZ, fcntl.ioctl(src, termios.TIOCGWINSZ, b"\0" * 8))
    except OSError:
        pass

def write_all(fd, data):
    while data:
        try:
            data = data[os.write(fd, data):]
        except InterruptedError:
            continue

def main(argv):
    if not argv:
        print("usage: host-pty COMMAND [ARGS...]", file=sys.stderr)
        return 2
    if not os.isatty(0):
        os.execvp(argv[0], argv)

    pid, master = pty.fork()
    if pid == 0:
        try:
            os.execvp(argv[0], argv)
        except OSError as e:
            print(f"host-pty: {argv[0]}: {e.strerror}", file=sys.stderr)
            os._exit(127)

    copy_winsize(0, master)
    signal.signal(signal.SIGWINCH, lambda *_: copy_winsize(0, master))
    saved = termios.tcgetattr(0)
    tty.setraw(0)
    fds, status = [0, master], None
    try:
        while True:
            if status is None:
                done, st = os.waitpid(pid, os.WNOHANG)
                if done:
                    status = st
            try:
                ready, _, _ = select.select(fds, [], [], 0 if status is not None else 0.5)
            except InterruptedError:
                continue
            if status is not None and master not in ready:
                break
            if 0 in ready:
                try:
                    data = os.read(0, 65536)
                except OSError:
                    data = b""
                if data:
                    write_all(master, data)
                else:
                    fds.remove(0)
                    os.kill(pid, signal.SIGHUP)
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError as e:
                    if e.errno != errno.EIO:
                        raise
                    data = b""
                if not data:
                    break
                write_all(1, data)
    finally:
        termios.tcsetattr(0, termios.TCSAFLUSH, saved)
        os.close(master)
    if status is None:
        status = os.waitpid(pid, 0)[1]
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return os.WEXITSTATUS(status)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
