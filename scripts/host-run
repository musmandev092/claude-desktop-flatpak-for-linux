#!/bin/bash
# host-run: run a command OUTSIDE the Flatpak sandbox — on the host, or inside
# a toolbox — so Claude's plugins (MCP servers) and Claude Code can use your
# real tools (node, npx, uvx, docker, git, ...).
#
# It is called in two ways:
#   1. Through a link named after a command (e.g. host-bin/npx -> host-run).
#      Then it runs that same command outside.
#   2. Directly:  host-run [--toolbox NAME | --host] COMMAND [ARGS...]
#      (useful in MCP configs that use an absolute path, or another toolbox).
set -u

# Some callers start us with an almost empty environment (e.g. Claude Code
# reading your login shell). flatpak-spawn still needs the session bus.
: "${HOME:=$(getent passwd "$(id -u)" | cut -d: -f6)}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=/run/flatpak/bus}"
: "${FLATPAK_ID:=io.github.musmandev092.ClaudeDesktop}"
export HOME XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS

CONF="$HOME/.config/claude-desktop-flatpak/settings.conf"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.var/app/$FLATPAK_ID/cache}/host-bridge"
# Same path on the host, in toolboxes and in the sandbox; private to us
RUN_DIR="$XDG_RUNTIME_DIR/app/$FLATPAK_ID/host-run"

# Where to run: TOOLBOX=<name> in settings.conf, or empty for the host itself
TOOLBOX=$(sed -n 's/^[[:space:]]*TOOLBOX=//p' "$CONF" 2>/dev/null | tail -n1 | tr -d "\"' ")

name=${0##*/}
if [ "$name" = "host-run" ]; then
    while [ $# -gt 0 ]; do
        case "$1" in
            --toolbox) TOOLBOX=${2:-}; shift 2 ;;
            --host)    TOOLBOX=""; shift ;;
            --)        shift; break ;;
            *)         break ;;
        esac
    done
    if [ $# -eq 0 ]; then
        echo "usage: host-run [--toolbox NAME | --host] COMMAND [ARGS...]" >&2
        exit 2
    fi
else
    set -- "$name" "$@"
fi

# ── Environment to pass along ───────────────────────────────────────────────
# Everything we have (API keys from the MCP config, etc.), except variables
# that only make sense inside the sandbox. It goes through a private file in
# "env -0" format: no size limit, and secrets never show up in `ps`.
mkdir -p -m 700 "$RUN_DIR"
find "$RUN_DIR" -name 'job.*' -mmin +1440 -delete 2>/dev/null   # leftovers of killed jobs
job=$(mktemp -p "$RUN_DIR" job.XXXXXXXX)
while IFS= read -r -d '' kv; do
    case "${kv%%=*}" in
        *PATH|LD_*|FLATPAK_*|DBUS_*|XDG_DATA_DIRS|XDG_CONFIG_DIRS|XDG_*_HOME|\
        container|GIO_*|GST_*|GDK_*|GTK_*|GSETTINGS_*|PYTHON*|ZYPAK_*|CHROME_*|\
        ELECTRON_*|SHELL|SHLVL|PWD|OLDPWD|_|HOST_BIN|BASH_FUNC_*) continue ;;
    esac
    # Values pointing into the sandbox (/run/flatpak/..., /app/...) are useless outside
    case "${kv#*=}" in
        */run/flatpak/*|/app/*) continue ;;
    esac
    printf '%s\0' "$kv"
done < <(env -0) > "$job"
# The real PATH of the host/toolbox (saved by host-bridge), so tools in
# ~/.local/bin, npm globals, etc. are found
if [ -s "$CACHE_DIR/${TOOLBOX:-host}.path" ]; then
    printf 'PATH=%s\0' "$(cat "$CACHE_DIR/${TOOLBOX:-host}.path")" >> "$job"
fi

# The working directory must exist outside too; the sandbox's /tmp and /app don't.
case "$PWD" in
    "$HOME"|"$HOME"/*|/run/user/*|/media/*|/mnt/*|/var/home/*) dir=$PWD ;;
    *) dir=$HOME ;;
esac

# Many commands starting at the same moment (Claude starts all MCP servers at
# once) can overflow the session bus proxy's queue. A 10 ms gap between
# connections prevents that.
{ flock 9; sleep 0.01; } 9>"$RUN_DIR/.lock"

# Loads the env file given as $0, deletes it, then runs the command
LOAD_ENV='while IFS= read -r -d "" kv; do export "$kv" 2>/dev/null; done < "$0"; rm -f "$0"; exec "$@"'

# ── On the host ──────────────────────────────────────────────────────────────
if [ -z "$TOOLBOX" ]; then
    if [ -t 0 ] && [ -t 1 ]; then
        # A terminal: host-spawn gives the command a real pseudo-terminal (pty)
        exec host-spawn -pty -cwd "$dir" -env TERM,COLORTERM bash --norc --noprofile -c "$LOAD_ENV" "$job" "$@"
    fi
    # Pipes: --watch-bus stops the command when Claude exits
    exec 3<"$job"; rm -f "$job"
    exec flatpak-spawn --host --watch-bus --directory="$dir" --env-fd=3 "$@"
fi

# ── Inside a toolbox ─────────────────────────────────────────────────────────
if [ -t 0 ] && [ -t 1 ]; then
    # A terminal: foreground with a real pty (closing the pty ends the command).
    # `toolbox run` gives it a terminal the toolbox can see.
    exec host-spawn -pty -cwd "$dir" -env TERM,COLORTERM \
        toolbox run -c "$TOOLBOX" bash --norc --noprofile -c "$LOAD_ENV" "$job" "$@"
fi

# Pipes (MCP servers, Claude Code commands):
# FAST PATH (runs on the host): step straight into the toolbox's namespaces
# with nsenter, like `podman exec` does but ~10x quicker (~40 ms instead of
# ~300 ms per command). The command then is a normal child of flatpak-spawn:
# stdio, exit code and signals pass through untouched, and nothing reads
# ~/.bashrc. The toolbox's PID is cached; a stopped toolbox is started first.
# If anything is unusual (no nsenter/setpriv, odd container), it falls back to
# the slower `toolbox run` way below.
FAST='box=$1 dir=$2 cache=$3 job=$4 launch=$5 watchdog=$6; shift 6
u=$(id -u) g=$(id -g) ns=$(command -v nsenter)
started() { [ -n "${pid:-}" ] && [ "$(cut -d" " -f22 "/proc/$pid/stat" 2>/dev/null)" = "$start" ]; }
read -r pid start 2>/dev/null <"$cache"
if [ -n "$ns" ] && ! started; then
    [ "$(podman inspect -f "{{.State.Running}}" "$box" 2>/dev/null)" = true ] ||
        toolbox run -c "$box" true </dev/null >/dev/null 2>&1
    pid=$(podman inspect -f "{{.State.Pid}}" "$box" 2>/dev/null)
    start=$(cut -d" " -f22 "/proc/$pid/stat" 2>/dev/null)
    if started && "$ns" -t "$pid" -U -m -- setpriv --reuid="$u" --regid="$g" --init-groups \
            --inh-caps=-all -- true </dev/null >/dev/null 2>&1; then
        echo "$pid $start" >"$cache.$$" && mv -f "$cache.$$" "$cache"
    else
        pid=
    fi
fi
if [ -n "$ns" ] && started; then
    while IFS= read -r -d "" kv; do export "$kv" 2>/dev/null; done <"$job"; rm -f "$job"
    exec "$ns" -t "$pid" -U -m --wd="$dir" -- setpriv --reuid="$u" --regid="$g" --init-groups \
        --inh-caps=-all -- "$@"
fi
# Fallback: the universal (slower) way through `toolbox run`
exec bash --norc --noprofile -c "$launch" launch "$box" "$watchdog" "$job" "$@"'

# Runs inside the toolbox (which sees host PIDs). Loads the environment,
# starts the command, and:
#   - stops the command if the host side ($1) disappears (Claude exited),
#   - forwards SIGTERM/SIGINT/SIGHUP,
#   - saves the real exit code, because `toolbox run` turns 127 into 0,
#   - writes the command's output to a private pipe ($job.out), because
#     `toolbox run` starts a login shell whose banners (fastfetch, motd…)
#     would otherwise mix into the output and break plugins' JSON.
WATCHDOG='p=$1 job=$2; shift 2
while IFS= read -r -d "" kv; do export "$kv" 2>/dev/null; done < "$job"; rm -f "$job"
"$@" <&0 >"$job.out" & c=$!
echo "$c" > "$job.pid"
( while kill -0 "$p" 2>/dev/null; do sleep 2; done
  kill -TERM "$c" 2>/dev/null; sleep 3; kill -KILL "$c" 2>/dev/null ) </dev/null >/dev/null 2>&1 & m=$!
trap '"'"'kill -TERM "$c" 2>/dev/null'"'"' TERM INT HUP
while :; do wait "$c"; s=$?; kill -0 "$c" 2>/dev/null || break; done
kill "$m" 2>/dev/null
echo "$s" > "$job.status"
# Host side already gone (Claude was killed): nobody else will clean up
kill -0 "$p" 2>/dev/null || rm -f "$job.out" "$job.pid" "$job.status"
exit "$s"'

# Runs on the host. Forwards signals straight to the command's PID, reports
# the saved exit code and cleans up.
LAUNCH='box=$1 wd=$2 job=$3; shift 3
trap '"'"'kill -TERM "$(cat "$job.pid" 2>/dev/null)" 2>/dev/null'"'"' TERM INT HUP
mkfifo -m 600 "$job.out"
cat "$job.out" & o=$!                    # the command'"'"'s real output
toolbox run -c "$box" bash --norc --noprofile -c "$wd" watchdog "$$" "$job" "$@" <&0 >/dev/null & t=$!
while :; do wait "$t"; r=$?; kill -0 "$t" 2>/dev/null || break; done
# If the command never started, nobody opened the pipe: unblock cat
kill -0 "$o" 2>/dev/null && ! [ -s "$job.pid" ] && : >"$job.out"
wait "$o"
[ -s "$job.status" ] && r=$(cat "$job.status")
rm -f "$job" "$job.pid" "$job.status" "$job.out"
exit "$r"'

exec flatpak-spawn --host --watch-bus --directory="$dir" bash --norc --noprofile -c "$FAST" \
    fast "$TOOLBOX" "$dir" "$RUN_DIR/$TOOLBOX.nspid" "$job" "$LAUNCH" "$WATCHDOG" "$@"
