#!/usr/bin/python3
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HOME = os.environ["HOME"]
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(
    HOME, ".var/app", os.environ["FLATPAK_ID"], "cache"), "host-bridge")
COMMANDS, PATH_FILE, SHELL_FILE = (os.path.join(CACHE_DIR, f) for f in ("host.commands", "host.path", "host.shell"))
HOST_BIN = os.environ.get("HOST_BIN") or os.path.join(
    os.environ["XDG_RUNTIME_DIR"], "app", os.environ["FLATPAK_ID"], "host-bin")
HOST_RUN = "/app/bin/host-run"
RUNNER = ".host-run"

SKIP = {"sh", "dash", "env", "flatpak-spawn", "host-spawn", "host-run",
        "host-bridge", "xdg-open", "xdg-email"}
PREFER_HOST = {"bash", "zsh", "fish", "python", "python3", "pip", "pip3",
               "git", "ssh", "scp", "perl", "ruby", "make", "gcc", "cc", "g++"}
NAME_OK = re.compile(r"^[A-Za-z0-9._+-]+$")

LIST = ('{ echo "@@HOST_BRIDGE_SHELL=$(getent passwd "$(id -u)" | cut -d: -f7)"; echo "@@HOST_BRIDGE_PATH=$PATH"; echo "@@HOST_BRIDGE_NAMES"; IFS=:; '
        'for d in $PATH; do [ -d "$d" ] && ls -1 "$d"; done; echo "@@HOST_BRIDGE_END"; } > "$HOST_BRIDGE_OUT"')
LOGIN = ('s=$(getent passwd "$(id -u)" | cut -d: -f7); '
         'exec "${s:-/bin/bash}" -l -c \'exec /bin/sh -c "$HOST_BRIDGE_LIST"\'')
PLAIN = 'PATH="$HOME/.local/bin:$HOME/bin:$PATH"; exec /bin/sh -c "$HOST_BRIDGE_LIST"'

def on_host(script, timeout):
    try:
        fd, result = tempfile.mkstemp(prefix=".host-bridge-scan.", dir=os.path.join(
            os.environ["XDG_RUNTIME_DIR"], "app", os.environ["FLATPAK_ID"]))
        os.close(fd)
    except OSError:
        return ""
    try:
        subprocess.run(
            ["flatpak-spawn", "--host", "--watch-bus", "--env=HOME=" + HOME,
             "--env=HOST_BRIDGE_LIST=" + LIST, "--env=HOST_BRIDGE_OUT=" + result,
             "/bin/sh", "-c", script],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=timeout)
        with open(result, errors="replace") as f:
            return f.read()
    except (OSError, subprocess.TimeoutExpired):
        return ""
    finally:
        try:
            os.unlink(result)
        except OSError:
            pass

def scan():
    out = on_host(LOGIN, 15)
    if "@@HOST_BRIDGE_END" not in out:
        out = on_host(PLAIN, 5)
    if "@@HOST_BRIDGE_END" not in out:
        return False
    head, names = out.split("@@HOST_BRIDGE_END", 1)[0].rsplit("@@HOST_BRIDGE_NAMES", 1)
    path = head.rsplit("@@HOST_BRIDGE_PATH=", 1)[-1].strip()
    login = re.search(r"@@HOST_BRIDGE_SHELL=(.*)", head)
    login = os.path.basename(login.group(1).strip()) if login else ""
    commands = sorted({n for n in names.split() if NAME_OK.match(n)})
    os.makedirs(CACHE_DIR, exist_ok=True)
    for name, data in ((PATH_FILE, path + "\n"), (COMMANDS, "\n".join(commands) + "\n"),
                       (SHELL_FILE, login + "\n")):
        with open(name + ".tmp", "w") as f:
            f.write(data)
        os.replace(name + ".tmp", name)
    return True

def shell():
    try:
        with open(SHELL_FILE) as f:
            login = f.read().strip()
    except OSError:
        login = ""
    for name in (login, "bash"):
        if name in ("bash", "zsh") and os.path.exists(os.path.join(HOST_BIN, name)):
            print(os.path.join(HOST_BIN, name))
            return True
    return False

def in_sandbox(name):
    return any(os.path.exists(os.path.join(d, name)) for d in ("/usr/bin", "/bin"))

def link():
    if not scan() and not os.path.exists(COMMANDS):
        print("host-bridge: could not reach the host", file=sys.stderr)
        return False
    with open(COMMANDS) as f:
        commands = f.read().split()
    wanted = sorted(n for n in commands
                    if n not in SKIP and not os.path.exists("/app/bin/" + n)
                    and (n in PREFER_HOST or not in_sandbox(n)))
    with open(HOST_RUN, "rb") as f:
        runner = f.read()
    tag = hashlib.sha1("\n".join(wanted).encode() + b"\0" + runner).hexdigest()[:12]
    target = f"{HOST_BIN}.{tag}"

    if os.path.islink(HOST_BIN) and os.readlink(HOST_BIN) == target and os.path.isdir(target):
        return True
    if not os.path.isdir(target):
        tmp = target + ".tmp"
        shutil.rmtree(tmp, ignore_errors=True)
        os.makedirs(tmp)
        with open(os.path.join(tmp, RUNNER), "wb") as f:
            f.write(runner)
        os.chmod(os.path.join(tmp, RUNNER), 0o755)
        for name in wanted:
            os.symlink(RUNNER, os.path.join(tmp, name))
        os.rename(tmp, target)
    pointer = HOST_BIN + ".link"
    if os.path.lexists(pointer):
        os.remove(pointer)
    os.symlink(target, pointer)
    os.replace(pointer, HOST_BIN)
    parent, base = os.path.split(HOST_BIN)
    for entry in os.listdir(parent):
        path = os.path.join(parent, entry)
        if entry.startswith(base + ".") and path != target and not entry.endswith(".link"):
            if time.time() - os.path.getmtime(path) > 3600:
                shutil.rmtree(path, ignore_errors=True)
    return True

if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "link"
    ok = {"link": link, "scan": scan, "shell": shell}.get(action, lambda: False)()
    sys.exit(0 if ok else 1)

